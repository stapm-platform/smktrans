# =========================================
# R Environment & renv
# =========================================
# Let Git track renv.lock and renv/activate.R, but ignore the heavy package libraries
renv/library/
renv/local/
renv/staging/
renv/python/
.Rproj.user/

# =========================================
# Data & Outputs
# =========================================
# Ignore input data folder
05_input/

# Ignore the ROOT outputs folder (preventing massive commits from other scripts)
/outputs/

# Ignore heavy model outputs everywhere by default
*.rds
*.csv
*.xlsx

# EXCEPTION: Explicitly track Excel files in this specific folder
!transition_probability_estimates/outputs/*.xlsx

# Ignore database and SPSS files anywhere in the project
*.db
*.sav

# =========================================
# OS & System Files
# =========================================
.DS_Store
*.zip

# =========================================
# Project Specific
# =========================================
inst/doc/
Archive/
dev/
public/
*.png

# --- Data files (do not commit data) ---
*.csv
*.tsv
*.xls
*.parquet
*.feather
*.h5
*.hdf5
*.nc
*.sqlite
*.db
*.dta
*.sav
*.rds
*.RData
*.npy
*.npz
*.pkl
*.pickle
*.mat
*.gpkg
*.shp
*.shx
*.dbf
*.geojson
*.las
*.laz
*.tif
*.tiff

# --- Data archives ---
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.7z

# --- Common data folders (keep the folder, not its contents) ---
data/
raw/
raw_data/
inputs/
# Tip: add a data/.gitkeep or data/README.md so the empty folder is tracked.

# --- Secrets & credentials (never commit) ---
.env
.env.*
*.pem
*.key
*.secret
secrets.*
credentials*
id_rsa*
.Renviron

# --- Notebook outputs / checkpoints ---
.ipynb_checkpoints/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/

# --- R ---
.Rhistory
.Rproj.user/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/

docs
docs/

